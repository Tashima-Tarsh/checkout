# Agentic-Recovery Environment Configuration (no secrets)
# Copy to .env and fill in actual values before running

# Database
DATABASE_URL=postgresql+psycopg2://agentic_recovery:changeme@localhost:5432/agentic_recovery

# Server
HOST=127.0.0.1
PORT=8000

# Security
SECRET_KEY=changeme-in-production
ENCRYPTION_KEY=changeme-32-byte-key-here

# Android
ANDROID_HOME=D:\Android\Sdk
ANDROID_SDK_ROOT=D:\Android\Sdk
ANDROID_AVD_HOME=D:\Agentic-Android\AVD

# n8n (local only until production approval)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=changeme

# Tenant
DEFAULT_TENANT=agentic-recovery-tenant
