{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private DISHA Checkout, Agentic Pay and n8n runtime for one existing Dev or UAT environment.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "AllowedValues": [
        "dev",
        "uat"
      ]
    },
    "Cluster": {
      "Type": "String"
    },
    "Subnets": {
      "Type": "CommaDelimitedList",
      "AllowedPattern": "subnet-[a-f0-9]+"
    },
    "TaskSecurityGroup": {
      "Type": "String",
      "AllowedPattern": "sg-[a-f0-9]+"
    },
    "NamespaceId": {
      "Type": "String",
      "AllowedPattern": "ns-[a-z0-9]+"
    },
    "ReleaseCommit": {
      "Type": "String",
      "AllowedPattern": "[0-9a-f]{40}"
    },
    "LogGroup": {
      "Type": "String"
    },
    "DatabaseEndpoint": {
      "Type": "String"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    },
    "RepositoryName": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9./_-]+"
    },
    "EnableBootstrap": {
      "Type": "String",
      "AllowedValues": [
        "Disabled",
        "Enabled"
      ],
      "Default": "Disabled"
    },
    "DatabaseMasterSecretArn": {
      "Type": "String",
      "Default": "",
      "Description": "Only used by the optional one-off database bootstrap task. Never read by application services."
    }
  },
  "Resources": {
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReadEnvironmentSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Ref": "CheckoutPassword"
                    },
                    {
                      "Ref": "AgenticPassword"
                    },
                    {
                      "Ref": "WorkflowPassword"
                    },
                    {
                      "Ref": "OwnerToken"
                    },
                    {
                      "Ref": "AccountKeySeed"
                    },
                    {
                      "Ref": "WorkflowToken"
                    },
                    {
                      "Ref": "WorkflowEncryptionKey"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${RepositoryName}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${LogGroup}:log-stream:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "InternalPort8080": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "Description": "Private application traffic within this environment"
      }
    },
    "InternalPort5678": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5678,
        "ToPort": 5678,
        "Description": "Private application traffic within this environment"
      }
    },
    "CheckoutDiscovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "checkout",
        "NamespaceId": {
          "Ref": "NamespaceId"
        },
        "DnsConfig": {
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "CheckoutTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "checkout",
            "Image": {
              "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${RepositoryName}:checkout-${ReleaseCommit}"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080
              }
            ],
            "Environment": [
              {
                "Name": "PORT",
                "Value": "8080"
              },
              {
                "Name": "PDEP_REQUIRE_POSTGRES",
                "Value": "1"
              },
              {
                "Name": "DISHA_RDS_HOST",
                "Value": {
                  "Ref": "DatabaseEndpoint"
                }
              }
            ],
            "Secrets": [
              {
                "Name": "DISHA_DB_PASSWORD",
                "ValueFrom": {
                  "Ref": "CheckoutPassword"
                }
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "python3 -c \"from urllib.request import urlopen; urlopen('http://127.0.0.1:8080/healthz',timeout=3).close()\""
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 90
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "checkout"
              }
            },
            "EntryPoint": [
              "python",
              "-c",
              "import base64\nimport hashlib\nimport os\nimport sys\nfrom urllib.parse import quote\n\ndb, url_variable = sys.argv[1:3]\nhost = os.environ[\"DISHA_RDS_HOST\"]\npasswd = quote(os.environ.pop(\"DISHA_DB_PASSWORD\"), safe=\"\")\nos.environ[url_variable] = (\n    f\"postgresql://{db}:{passwd}@{host}:5432/{db}\"\n    \"?sslmode=verify-full&sslrootcert=/opt/disha/rds-ca.pem\"\n)\nif \"DISHA_ACCOUNT_KEY_SEED\" in os.environ:\n    seed = os.environ.pop(\"DISHA_ACCOUNT_KEY_SEED\").encode()\n    os.environ[\"AGENTIC_ACCOUNT_KEY\"] = base64.urlsafe_b64encode(\n        hashlib.sha256(seed).digest()\n    ).decode()\nos.execvp(sys.argv[3], sys.argv[3:])",
              "checkout_app",
              "DATABASE_URL",
              "sh",
              "-ec",
              "alembic upgrade head; exec uvicorn checkout.server:app --host 0.0.0.0 --port 8080 --no-access-log"
            ]
          }
        ]
      }
    },
    "CheckoutService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "LaunchType": "FARGATE",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "TaskDefinition": {
          "Ref": "CheckoutTask"
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": {
              "Ref": "Subnets"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSecurityGroup"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "CheckoutDiscovery",
                "Arn"
              ]
            }
          }
        ],
        "DeploymentConfiguration": {
          "MaximumPercent": 100,
          "MinimumHealthyPercent": 0,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        }
      }
    },
    "AgenticDiscovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "agentic",
        "NamespaceId": {
          "Ref": "NamespaceId"
        },
        "DnsConfig": {
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "AgenticTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "agentic",
            "Image": {
              "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${RepositoryName}:agentic-${ReleaseCommit}"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080
              }
            ],
            "Environment": [
              {
                "Name": "PORT",
                "Value": "8080"
              },
              {
                "Name": "AGENTIC_TEST_AUTO",
                "Value": "0"
              },
              {
                "Name": "AGENTIC_N8N_WEBHOOK",
                "Value": {
                  "Fn::Sub": "http://workflow.${EnvironmentName}.disha.internal:5678/webhook/agentic-pay-dispatch"
                }
              },
              {
                "Name": "DISHA_RDS_HOST",
                "Value": {
                  "Ref": "DatabaseEndpoint"
                }
              }
            ],
            "Secrets": [
              {
                "Name": "DISHA_DB_PASSWORD",
                "ValueFrom": {
                  "Ref": "AgenticPassword"
                }
              },
              {
                "Name": "AGENTIC_OWNER_TOKEN",
                "ValueFrom": {
                  "Ref": "OwnerToken"
                }
              },
              {
                "Name": "DISHA_ACCOUNT_KEY_SEED",
                "ValueFrom": {
                  "Ref": "AccountKeySeed"
                }
              },
              {
                "Name": "AGENTIC_N8N_TOKEN",
                "ValueFrom": {
                  "Ref": "WorkflowToken"
                }
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "python3 -c \"from urllib.request import urlopen; urlopen('http://127.0.0.1:8080/healthz',timeout=3).close()\""
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 90
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "agentic"
              }
            },
            "EntryPoint": [
              "python",
              "-c",
              "import base64\nimport hashlib\nimport os\nimport sys\nfrom urllib.parse import quote\n\ndb, url_variable = sys.argv[1:3]\nhost = os.environ[\"DISHA_RDS_HOST\"]\npasswd = quote(os.environ.pop(\"DISHA_DB_PASSWORD\"), safe=\"\")\nos.environ[url_variable] = (\n    f\"postgresql://{db}:{passwd}@{host}:5432/{db}\"\n    \"?sslmode=verify-full&sslrootcert=/opt/disha/rds-ca.pem\"\n)\nif \"DISHA_ACCOUNT_KEY_SEED\" in os.environ:\n    seed = os.environ.pop(\"DISHA_ACCOUNT_KEY_SEED\").encode()\n    os.environ[\"AGENTIC_ACCOUNT_KEY\"] = base64.urlsafe_b64encode(\n        hashlib.sha256(seed).digest()\n    ).decode()\nos.execvp(sys.argv[3], sys.argv[3:])",
              "agenticpay",
              "AGENTIC_DATABASE_URL",
              "uvicorn",
              "checkout.agentic_app:app",
              "--host",
              "0.0.0.0",
              "--port",
              "8080",
              "--no-access-log"
            ]
          }
        ]
      }
    },
    "AgenticService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "LaunchType": "FARGATE",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "TaskDefinition": {
          "Ref": "AgenticTask"
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": {
              "Ref": "Subnets"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSecurityGroup"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "AgenticDiscovery",
                "Arn"
              ]
            }
          }
        ],
        "DeploymentConfiguration": {
          "MaximumPercent": 100,
          "MinimumHealthyPercent": 0,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        }
      }
    },
    "WorkflowDiscovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "workflow",
        "NamespaceId": {
          "Ref": "NamespaceId"
        },
        "DnsConfig": {
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "WorkflowTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "workflow",
            "Image": {
              "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${RepositoryName}:workflow-${ReleaseCommit}"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 5678
              }
            ],
            "Environment": [
              {
                "Name": "DB_TYPE",
                "Value": "postgresdb"
              },
              {
                "Name": "DB_POSTGRESDB_DATABASE",
                "Value": "n8n"
              },
              {
                "Name": "DB_POSTGRESDB_HOST",
                "Value": {
                  "Ref": "DatabaseEndpoint"
                }
              },
              {
                "Name": "DB_POSTGRESDB_PORT",
                "Value": "5432"
              },
              {
                "Name": "DB_POSTGRESDB_SSL_ENABLED",
                "Value": "true"
              },
              {
                "Name": "N8N_LISTEN_ADDRESS",
                "Value": "0.0.0.0"
              },
              {
                "Name": "N8N_PORT",
                "Value": "5678"
              },
              {
                "Name": "EXECUTIONS_MODE",
                "Value": "regular"
              },
              {
                "Name": "N8N_DIAGNOSTICS_ENABLED",
                "Value": "false"
              },
              {
                "Name": "N8N_PERSONALIZATION_ENABLED",
                "Value": "false"
              },
              {
                "Name": "DB_POSTGRESDB_USER",
                "Value": "n8n"
              },
              {
                "Name": "DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED",
                "Value": "true"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_POSTGRESDB_PASSWORD",
                "ValueFrom": {
                  "Ref": "WorkflowPassword"
                }
              },
              {
                "Name": "N8N_ENCRYPTION_KEY",
                "ValueFrom": {
                  "Ref": "WorkflowEncryptionKey"
                }
              },
              {
                "Name": "AGENTIC_N8N_TOKEN",
                "ValueFrom": {
                  "Ref": "WorkflowToken"
                }
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "python3 -c \"from urllib.request import urlopen; urlopen('http://127.0.0.1:5678/healthz',timeout=3).close()\""
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 90
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "workflow"
              }
            }
          }
        ]
      }
    },
    "WorkflowService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "LaunchType": "FARGATE",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "TaskDefinition": {
          "Ref": "WorkflowTask"
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": {
              "Ref": "Subnets"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSecurityGroup"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "WorkflowDiscovery",
                "Arn"
              ]
            }
          }
        ],
        "DeploymentConfiguration": {
          "MaximumPercent": 100,
          "MinimumHealthyPercent": 0,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        }
      }
    },
    "CheckoutPassword": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "DISHA nonproduction CheckoutPassword",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "IncludeSpace": false
        }
      }
    },
    "AgenticPassword": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "DISHA nonproduction AgenticPassword",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "IncludeSpace": false
        }
      }
    },
    "WorkflowPassword": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "DISHA nonproduction WorkflowPassword",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "IncludeSpace": false
        }
      }
    },
    "OwnerToken": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "DISHA nonproduction OwnerToken",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "IncludeSpace": false
        }
      }
    },
    "AccountKeySeed": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "DISHA nonproduction AccountKeySeed",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "IncludeSpace": false
        }
      }
    },
    "WorkflowToken": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "DISHA nonproduction WorkflowToken",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "IncludeSpace": false
        }
      }
    },
    "WorkflowEncryptionKey": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "DISHA nonproduction WorkflowEncryptionKey",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "IncludeSpace": false
        }
      }
    },
    "BootstrapRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "BootstrapEnabled",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OneEnvironmentDatabaseBootstrap",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Ref": "DatabaseMasterSecretArn"
                    },
                    {
                      "Ref": "CheckoutPassword"
                    },
                    {
                      "Ref": "AgenticPassword"
                    },
                    {
                      "Ref": "WorkflowPassword"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${RepositoryName}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${LogGroup}:log-stream:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DatabaseBootstrapTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "BootstrapRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "databases",
            "Image": {
              "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${RepositoryName}:checkout-${ReleaseCommit}"
            },
            "Essential": true,
            "EntryPoint": [
              "python",
              "-c",
              "\"\"\"Create separate app-owned databases on an empty Dev or UAT RDS instance.\"\"\"\n\nimport json\nimport os\n\nimport psycopg\nfrom psycopg import sql\n\n\nDATABASES = {\"checkout_app\": \"checkout_app\", \"agenticpay\": \"agenticpay\", \"n8n\": \"n8n\"}\n\n\ndef bootstrap() -> None:\n    environment = os.environ[\"DISHA_ENVIRONMENT\"]\n    if environment not in {\"dev\", \"uat\"}:\n        raise ValueError(\"DISHA_ENVIRONMENT must be dev or uat\")\n    host = os.environ[\"DISHA_RDS_HOST\"]\n    if not host.endswith(\".ap-southeast-2.rds.amazonaws.com\"):\n        raise ValueError(\"Expected a Sydney private RDS endpoint\")\n    admin = json.loads(os.environ[\"RDS_MASTER_JSON\"])\n    credentials = {\"admin_username\": admin[\"username\"], \"admin_password\": admin[\"password\"]}\n    passwords = {role: os.environ[role.upper() + \"_PASSWORD\"] for role in DATABASES}\n    if set(passwords) != set(DATABASES) or any(\n        not isinstance(password, str) or len(password) < 24\n        for password in passwords.values()\n    ):\n        raise ValueError(\"Expected one strong password per application role\")\n\n    with psycopg.connect(\n        host=host,\n        dbname=\"postgres\",\n        user=credentials[\"admin_username\"],\n        password=credentials[\"admin_password\"],\n        sslmode=\"verify-full\",\n        sslrootcert=os.environ[\"DISHA_RDS_CA_BUNDLE\"],\n        connect_timeout=10,\n        autocommit=True,\n    ) as conn:\n        conn.execute(\"SELECT pg_advisory_lock(356078311)\")\n        for database, role in DATABASES.items():\n            owner = conn.execute(\n                \"SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = %s\",\n                (database,),\n            ).fetchone()\n            if owner is not None and owner[0] != role:\n                raise RuntimeError(f\"Refusing to change the owner of {database}\")\n\n            role_exists = conn.execute(\n                \"SELECT 1 FROM pg_roles WHERE rolname = %s\", (role,)\n            ).fetchone()\n            if not role_exists:\n                conn.execute(\n                    sql.SQL(\"CREATE ROLE {} LOGIN PASSWORD {}\").format(\n                        sql.Identifier(role), sql.Literal(passwords[role])\n                    )\n                )\n\n            if owner is None:\n                admin = sql.Identifier(credentials[\"admin_username\"])\n                app_role = sql.Identifier(role)\n                can_set_role = conn.execute(\n                    \"SELECT pg_has_role(current_user, %s, 'SET')\", (role,)\n                ).fetchone()[0]\n                if not can_set_role:\n                    conn.execute(\n                        sql.SQL(\"GRANT {} TO {} WITH SET TRUE\").format(app_role, admin)\n                    )\n                try:\n                    conn.execute(\n                        sql.SQL(\"CREATE DATABASE {} OWNER {}\").format(\n                            sql.Identifier(database), app_role\n                        )\n                    )\n                finally:\n                    if not can_set_role:\n                        conn.execute(\n                            sql.SQL(\"REVOKE SET OPTION FOR {} FROM {}\").format(\n                                app_role, admin\n                            )\n                        )\n\n            with psycopg.connect(\n                host=host,\n                dbname=database,\n                user=role,\n                password=passwords[role],\n                sslmode=\"verify-full\",\n                sslrootcert=os.environ[\"DISHA_RDS_CA_BUNDLE\"],\n                connect_timeout=10,\n            ) as app_conn:\n                app_conn.execute(\n                    sql.SQL(\"REVOKE CONNECT, TEMPORARY ON DATABASE {} FROM PUBLIC\").format(\n                        sql.Identifier(database)\n                    )\n                )\n            print(f\"{environment}: verified role and database for {database}\")\n\n\nif __name__ == \"__main__\":\n    bootstrap()"
            ],
            "Secrets": [
              {
                "Name": "RDS_MASTER_JSON",
                "ValueFrom": {
                  "Ref": "DatabaseMasterSecretArn"
                }
              },
              {
                "Name": "CHECKOUT_APP_PASSWORD",
                "ValueFrom": {
                  "Ref": "CheckoutPassword"
                }
              },
              {
                "Name": "AGENTICPAY_PASSWORD",
                "ValueFrom": {
                  "Ref": "AgenticPassword"
                }
              },
              {
                "Name": "N8N_PASSWORD",
                "ValueFrom": {
                  "Ref": "WorkflowPassword"
                }
              }
            ],
            "Environment": [
              {
                "Name": "DISHA_RDS_HOST",
                "Value": {
                  "Ref": "DatabaseEndpoint"
                }
              },
              {
                "Name": "DISHA_RDS_CA_BUNDLE",
                "Value": "/opt/disha/rds-ca.pem"
              },
              {
                "Name": "DISHA_ENVIRONMENT",
                "Value": {
                  "Ref": "EnvironmentName"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "checkout"
              }
            }
          }
        ]
      },
      "Condition": "BootstrapEnabled"
    },
    "WorkflowBootstrapTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "workflow-bootstrap",
            "Image": {
              "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${RepositoryName}:workflow-${ReleaseCommit}"
            },
            "Essential": true,
            "EntryPoint": [
              "node",
              "/opt/agentic-pay/bootstrap.mjs"
            ],
            "Secrets": [
              {
                "Name": "DB_POSTGRESDB_PASSWORD",
                "ValueFrom": {
                  "Ref": "WorkflowPassword"
                }
              },
              {
                "Name": "N8N_ENCRYPTION_KEY",
                "ValueFrom": {
                  "Ref": "WorkflowEncryptionKey"
                }
              },
              {
                "Name": "AGENTIC_N8N_TOKEN",
                "ValueFrom": {
                  "Ref": "WorkflowToken"
                }
              }
            ],
            "Environment": [
              {
                "Name": "DB_TYPE",
                "Value": "postgresdb"
              },
              {
                "Name": "DB_POSTGRESDB_DATABASE",
                "Value": "n8n"
              },
              {
                "Name": "DB_POSTGRESDB_HOST",
                "Value": {
                  "Ref": "DatabaseEndpoint"
                }
              },
              {
                "Name": "DB_POSTGRESDB_PORT",
                "Value": "5432"
              },
              {
                "Name": "DB_POSTGRESDB_SSL_ENABLED",
                "Value": "true"
              },
              {
                "Name": "N8N_LISTEN_ADDRESS",
                "Value": "0.0.0.0"
              },
              {
                "Name": "N8N_PORT",
                "Value": "5678"
              },
              {
                "Name": "EXECUTIONS_MODE",
                "Value": "regular"
              },
              {
                "Name": "N8N_DIAGNOSTICS_ENABLED",
                "Value": "false"
              },
              {
                "Name": "N8N_PERSONALIZATION_ENABLED",
                "Value": "false"
              },
              {
                "Name": "DB_POSTGRESDB_USER",
                "Value": "n8n"
              },
              {
                "Name": "DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED",
                "Value": "true"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "workflow"
              }
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "CheckoutPrivateUrl": {
      "Value": {
        "Fn::Sub": "http://checkout.${EnvironmentName}.disha.internal:8080"
      }
    },
    "AgenticPrivateUrl": {
      "Value": {
        "Fn::Sub": "http://agentic.${EnvironmentName}.disha.internal:8080"
      }
    },
    "WorkflowPrivateUrl": {
      "Value": {
        "Fn::Sub": "http://workflow.${EnvironmentName}.disha.internal:5678"
      }
    },
    "DatabaseBootstrapTask": {
      "Condition": "BootstrapEnabled",
      "Value": {
        "Ref": "DatabaseBootstrapTask"
      }
    },
    "WorkflowBootstrapTask": {
      "Value": {
        "Ref": "WorkflowBootstrapTask"
      }
    }
  },
  "Conditions": {
    "BootstrapEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableBootstrap"
        },
        "Enabled"
      ]
    }
  },
  "Rules": {
    "BootstrapNeedsMasterSecret": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "EnableBootstrap"
          },
          "Enabled"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "DatabaseMasterSecretArn"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Provide this environment's RDS master secret ARN when enabling the bootstrap task."
        }
      ]
    }
  }
}
