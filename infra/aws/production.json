{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DISHA checkout production infrastructure. Application services start at zero tasks.",
  "Parameters": {
    "MerchantOnboardingAuthorized": {
      "Type": "String",
      "Default": "No",
      "AllowedValues": [
        "No",
        "Yes"
      ],
      "Description": "Set to Yes only after approval to provision paid infrastructure for the first merchant."
    },
    "FoundationStackName": {
      "Type": "String",
      "Default": "DISHA8-2"
    },
    "AlertEmail": {
      "Type": "String",
      "Default": ""
    },
    "MonthlyBudgetUSD": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0
    },
    "AlertEmailForBudget": {
      "Type": "String",
      "Default": ""
    },
    "EdgeStackName": {
      "Type": "String",
      "Default": "DISHA8-2-Production-Edge"
    },
    "BackupRetentionDays": {
      "Type": "Number",
      "Default": 7,
      "MinValue": 0,
      "MaxValue": 35,
      "Description": "Retention for PostgreSQL and Redis automated backups. Set to zero only for deployments configured without automated backups."
    },
    "ExistingCheckoutRepository": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9][a-z0-9._/-]+$",
      "Description": "Optional existing immutable ECR repository for Checkout."
    },
    "ExistingAgenticRepository": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9][a-z0-9._/-]+$",
      "Description": "Optional existing immutable ECR repository for Agentic."
    },
    "ExistingWorkflowRepository": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9][a-z0-9._/-]+$",
      "Description": "Optional existing immutable ECR repository for Workflow."
    },
    "PrivateInterfaceEndpoints": {
      "Type": "String",
      "Default": "Enabled",
      "AllowedValues": [
        "Enabled",
        "Deferred"
      ],
      "Description": "Defer interface endpoints while a prior deployment releases its private DNS records. Enable before starting application tasks."
    },
    "DatabaseMultiAZ": {
      "Type": "String",
      "Default": "Enabled",
      "AllowedValues": [
        "Enabled",
        "Disabled"
      ],
      "Description": "Use Disabled on AWS Free accounts, which permit only single-AZ RDS instances."
    }
  },
  "Rules": {
    "RequireMerchantOnboardingAuthorization": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "MerchantOnboardingAuthorized"
              },
              "Yes"
            ]
          },
          "AssertDescription": "Provision paid production infrastructure only after first merchant onboarding is authorized."
        }
      ]
    }
  },
  "Conditions": {
    "HasAlerts": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlertEmail"
            },
            ""
          ]
        }
      ]
    },
    "HasBudget": {
      "Fn::And": [
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "MonthlyBudgetUSD"
                },
                0
              ]
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "AlertEmailForBudget"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "HasBackups": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "BackupRetentionDays"
            },
            0
          ]
        }
      ]
    },
    "CreateCheckoutRepository": {
      "Fn::Equals": [
        {
          "Ref": "ExistingCheckoutRepository"
        },
        ""
      ]
    },
    "CreateAgenticRepository": {
      "Fn::Equals": [
        {
          "Ref": "ExistingAgenticRepository"
        },
        ""
      ]
    },
    "CreateWorkflowRepository": {
      "Fn::Equals": [
        {
          "Ref": "ExistingWorkflowRepository"
        },
        ""
      ]
    },
    "HasPrivateInterfaceEndpoints": {
      "Fn::Equals": [
        {
          "Ref": "PrivateInterfaceEndpoints"
        },
        "Enabled"
      ]
    },
    "HasMultiAzDatabase": {
      "Fn::Equals": [
        {
          "Ref": "DatabaseMultiAZ"
        },
        "Enabled"
      ]
    }
  },
  "Resources": {
    "ApiSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Checkout application",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${EdgeStackName}-EdgeSecurityGroupId"
              }
            }
          }
        ]
      }
    },
    "WorkflowSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Internal workflow application",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5678,
            "ToPort": 5678,
            "SourceSecurityGroupId": {
              "Ref": "ApiSecurityGroup"
            }
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL from application tasks",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "ApiSecurityGroup"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "WorkflowSecurityGroup"
            }
          }
        ]
      }
    },
    "CacheSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Redis from checkout tasks",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 6379,
            "ToPort": 6379,
            "SourceSecurityGroupId": {
              "Ref": "ApiSecurityGroup"
            }
          }
        ]
      }
    },
    "EndpointSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "AWS API endpoints from application tasks",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "SourceSecurityGroupId": {
              "Ref": "ApiSecurityGroup"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "SourceSecurityGroupId": {
              "Ref": "WorkflowSecurityGroup"
            }
          }
        ]
      },
      "Condition": "HasPrivateInterfaceEndpoints"
    },
    "EcrApi": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.ecr.api"
        },
        "SubnetIds": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
            }
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PrivateDnsEnabled": true
      },
      "Condition": "HasPrivateInterfaceEndpoints"
    },
    "EcrDocker": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.ecr.dkr"
        },
        "SubnetIds": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
            }
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PrivateDnsEnabled": true
      },
      "Condition": "HasPrivateInterfaceEndpoints"
    },
    "LogsEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.logs"
        },
        "SubnetIds": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
            }
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PrivateDnsEnabled": true
      },
      "Condition": "HasPrivateInterfaceEndpoints"
    },
    "SecretsEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.secretsmanager"
        },
        "SubnetIds": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
            }
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PrivateDnsEnabled": true
      },
      "Condition": "HasPrivateInterfaceEndpoints"
    },
    "S3Endpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "VpcEndpointType": "Gateway",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.s3"
        },
        "RouteTableIds": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateRouteTableA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateRouteTableB"
            }
          }
        ]
      }
    },
    "DatabaseSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "DISHA PostgreSQL private subnets",
        "SubnetIds": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
            }
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "MaxAllocatedStorage": 100,
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MultiAZ": {
          "Fn::If": [
            "HasMultiAzDatabase",
            true,
            false
          ]
        },
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": {
          "Ref": "BackupRetentionDays"
        },
        "CopyTagsToSnapshot": true,
        "DeletionProtection": true,
        "ManageMasterUserPassword": true,
        "MasterUsername": "dishaadmin",
        "DBName": "checkout",
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ]
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "CacheSubnetGroup": {
      "Type": "AWS::ElastiCache::SubnetGroup",
      "Properties": {
        "Description": "DISHA Redis private subnets",
        "SubnetIds": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
            }
          }
        ]
      }
    },
    "Cache": {
      "Type": "AWS::ElastiCache::ReplicationGroup",
      "Properties": {
        "ReplicationGroupDescription": "DISHA application Redis",
        "Engine": "redis",
        "EngineVersion": "7.1",
        "CacheNodeType": "cache.t4g.micro",
        "CacheSubnetGroupName": {
          "Ref": "CacheSubnetGroup"
        },
        "SecurityGroupIds": [
          {
            "Ref": "CacheSecurityGroup"
          }
        ],
        "NumCacheClusters": 2,
        "AutomaticFailoverEnabled": true,
        "MultiAZEnabled": true,
        "AtRestEncryptionEnabled": true,
        "TransitEncryptionEnabled": true,
        "SnapshotRetentionLimit": {
          "Ref": "BackupRetentionDays"
        }
      }
    },
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Condition": "HasBackups"
    },
    "BackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "BackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      },
      "Condition": "HasBackups"
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ]
      }
    },
    "WebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": true,
          "MetricName": "DishaEdge"
        },
        "Rules": [
          {
            "Name": "CommonRules",
            "Priority": 0,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesCommonRuleSet"
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "DishaCommonRules"
            }
          }
        ]
      }
    },
    "WebAclAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": {
          "Fn::ImportValue": {
            "Fn::Sub": "${EdgeStackName}-EdgeArn"
          }
        },
        "WebACLArn": {
          "Fn::GetAtt": [
            "WebAcl",
            "Arn"
          ]
        }
      }
    },
    "CheckoutImages": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Condition": "CreateCheckoutRepository"
    },
    "CheckoutLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      }
    },
    "CheckoutTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "checkout",
            "Image": {
              "Fn::Sub": [
                "${RepositoryUri}:release",
                {
                  "RepositoryUri": {
                    "Fn::If": [
                      "CreateCheckoutRepository",
                      {
                        "Fn::GetAtt": [
                          "CheckoutImages",
                          "RepositoryUri"
                        ]
                      },
                      {
                        "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${ExistingCheckoutRepository}"
                      }
                    ]
                  }
                }
              ]
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "CheckoutLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "ecs"
              }
            }
          }
        ]
      }
    },
    "CheckoutService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "DesiredCount": 0,
        "LaunchType": "FARGATE",
        "TaskDefinition": {
          "Ref": "CheckoutTask"
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
                }
              },
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
                }
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "ApiSecurityGroup"
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        }
      }
    },
    "AgenticImages": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Condition": "CreateAgenticRepository"
    },
    "AgenticLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      }
    },
    "AgenticTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "agentic",
            "Image": {
              "Fn::Sub": [
                "${RepositoryUri}:release",
                {
                  "RepositoryUri": {
                    "Fn::If": [
                      "CreateAgenticRepository",
                      {
                        "Fn::GetAtt": [
                          "AgenticImages",
                          "RepositoryUri"
                        ]
                      },
                      {
                        "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${ExistingAgenticRepository}"
                      }
                    ]
                  }
                }
              ]
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "AgenticLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "ecs"
              }
            }
          }
        ]
      }
    },
    "AgenticService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "DesiredCount": 0,
        "LaunchType": "FARGATE",
        "TaskDefinition": {
          "Ref": "AgenticTask"
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
                }
              },
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
                }
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "ApiSecurityGroup"
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        }
      }
    },
    "WorkflowImages": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Condition": "CreateWorkflowRepository"
    },
    "WorkflowLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      }
    },
    "WorkflowTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "workflow",
            "Image": {
              "Fn::Sub": [
                "${RepositoryUri}:release",
                {
                  "RepositoryUri": {
                    "Fn::If": [
                      "CreateWorkflowRepository",
                      {
                        "Fn::GetAtt": [
                          "WorkflowImages",
                          "RepositoryUri"
                        ]
                      },
                      {
                        "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${ExistingWorkflowRepository}"
                      }
                    ]
                  }
                }
              ]
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 5678,
                "Protocol": "tcp"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkflowLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "ecs"
              }
            }
          }
        ]
      }
    },
    "WorkflowService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "DesiredCount": 0,
        "LaunchType": "FARGATE",
        "TaskDefinition": {
          "Ref": "WorkflowTask"
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-PrivateSubnetA"
                }
              },
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-PrivateSubnetB"
                }
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "WorkflowSecurityGroup"
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        }
      }
    },
    "MerchantPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "DeletionProtection": "ACTIVE",
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true
          }
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "Subscription": [
          {
            "Protocol": "email",
            "Endpoint": {
              "Ref": "AlertEmail"
            }
          }
        ]
      },
      "Condition": "HasAlerts"
    },
    "DatabaseCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/RDS",
        "MetricName": "CPUUtilization",
        "Dimensions": [
          {
            "Name": "DBInstanceIdentifier",
            "Value": {
              "Ref": "Database"
            }
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlerts",
            [
              {
                "Ref": "Alerts"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "EdgeLatencyAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "TargetResponseTime",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::Select": [
                1,
                {
                  "Fn::Split": [
                    "loadbalancer/",
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${EdgeStackName}-EdgeArn"
                      }
                    }
                  ]
                }
              ]
            }
          }
        ],
        "ExtendedStatistic": "p95",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 2,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlerts",
            [
              {
                "Ref": "Alerts"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "MonthlyBudget": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
          "BudgetLimit": {
            "Amount": {
              "Ref": "MonthlyBudgetUSD"
            },
            "Unit": "USD"
          }
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 50,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "AlertEmailForBudget"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 80,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "AlertEmailForBudget"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "AlertEmailForBudget"
                }
              }
            ]
          }
        ]
      },
      "Condition": "HasBudget"
    },
    "EdgeErrorRateAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Metrics": [
          {
            "Id": "errors",
            "ReturnData": false,
            "MetricStat": {
              "Period": 300,
              "Stat": "Sum",
              "Metric": {
                "Namespace": "AWS/ApplicationELB",
                "MetricName": "HTTPCode_Target_5XX_Count",
                "Dimensions": [
                  {
                    "Name": "LoadBalancer",
                    "Value": {
                      "Fn::Select": [
                        1,
                        {
                          "Fn::Split": [
                            "loadbalancer/",
                            {
                              "Fn::ImportValue": {
                                "Fn::Sub": "${EdgeStackName}-EdgeArn"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          {
            "Id": "requests",
            "ReturnData": false,
            "MetricStat": {
              "Period": 300,
              "Stat": "Sum",
              "Metric": {
                "Namespace": "AWS/ApplicationELB",
                "MetricName": "RequestCount",
                "Dimensions": [
                  {
                    "Name": "LoadBalancer",
                    "Value": {
                      "Fn::Select": [
                        1,
                        {
                          "Fn::Split": [
                            "loadbalancer/",
                            {
                              "Fn::ImportValue": {
                                "Fn::Sub": "${EdgeStackName}-EdgeArn"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          {
            "Id": "rate",
            "Expression": "IF(requests>0,100*FILL(errors,0)/requests,0)",
            "ReturnData": true
          }
        ],
        "EvaluationPeriods": 3,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlerts",
            [
              {
                "Ref": "Alerts"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "LoadBalancerDns": {
      "Value": {
        "Fn::ImportValue": {
          "Fn::Sub": "${EdgeStackName}-EdgeDns"
        }
      }
    },
    "DatabaseEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "DatabaseMasterSecret": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      }
    },
    "RedisEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Cache",
          "PrimaryEndPoint.Address"
        ]
      }
    },
    "BackupBucket": {
      "Value": {
        "Ref": "BackupBucket"
      },
      "Condition": "HasBackups"
    },
    "MerchantPool": {
      "Value": {
        "Ref": "MerchantPool"
      }
    },
    "CheckoutRepository": {
      "Value": {
        "Fn::If": [
          "CreateCheckoutRepository",
          {
            "Fn::GetAtt": [
              "CheckoutImages",
              "RepositoryUri"
            ]
          },
          {
            "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${ExistingCheckoutRepository}"
          }
        ]
      }
    },
    "AgenticRepository": {
      "Value": {
        "Fn::If": [
          "CreateAgenticRepository",
          {
            "Fn::GetAtt": [
              "AgenticImages",
              "RepositoryUri"
            ]
          },
          {
            "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${ExistingAgenticRepository}"
          }
        ]
      }
    },
    "WorkflowRepository": {
      "Value": {
        "Fn::If": [
          "CreateWorkflowRepository",
          {
            "Fn::GetAtt": [
              "WorkflowImages",
              "RepositoryUri"
            ]
          },
          {
            "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}/${ExistingWorkflowRepository}"
          }
        ]
      }
    }
  }
}
