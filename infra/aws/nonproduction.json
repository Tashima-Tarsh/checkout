  "Outputs": {
    "DevVpc": {
      "Value": {
        "Ref": "DevVpc"
      }
    },
    "DevSubnetA": {
      "Value": {
        "Ref": "DevSubnetA"
      }
    },
    "DevSubnetB": {
      "Value": {
        "Ref": "DevSubnetB"
      }
    },
    "DevCluster": {
      "Value": {
        "Ref": "DevCluster"
      }
    },
    "DevImages": {
      "Value": {
