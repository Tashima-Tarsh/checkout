{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DISHA 8.2 independent production portal ingress; fail closed until tested applications are attached.",
  "Parameters": {
    "FoundationStackName": {
      "Type": "String",
      "Default": "DISHA8-2"
    },
    "CertificateArn": {
      "Type": "String"
    }
  },
  "Resources": {
    "EdgeSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "DISHA production portal HTTPS ingress",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Edge": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PublicSubnetA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-PublicSubnetB"
            }
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "EdgeSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.desync_mitigation_mode",
            "Value": "strictest"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "DISHA8-2"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "CheckoutTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "TargetType": "ip",
        "Port": 8080,
        "Protocol": "HTTP",
        "HealthCheckPath": "/healthz",
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "checkout"
          }
        ]
      }
    },
    "AgenticTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-DishaVpc"
          }
        },
        "TargetType": "ip",
        "Port": 8080,
        "Protocol": "HTTP",
        "HealthCheckPath": "/healthz",
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "agentic"
          }
        ]
      }
    },
    "HttpListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Edge"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Edge"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2: unknown portal hostname"
            }
          }
        ]
      }
    },
    "SuperAdminRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 10,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "superadmin.disha8-2.thenitishkr.in"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "503",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2 Super Admin: application release not available."
            }
          }
        ]
      }
    },
    "MerchantRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 11,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "merchant.disha8-2.thenitishkr.in"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "503",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2 Merchant Portal: application release not available."
            }
          }
        ]
      }
    },
    "AgentRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 12,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "agenticpay.disha8-2.thenitishkr.in"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "503",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2 Agent Portal: application release not available."
            }
          }
        ]
      }
    },
    "SupportRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 13,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "support.disha8-2.thenitishkr.in"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "503",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2 Support Portal: application release not available."
            }
          }
        ]
      }
    },
    "CheckoutRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 14,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "checkout.disha8-2.thenitishkr.in"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "503",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2 Payment Checkout: application release not available."
            }
          }
        ]
      }
    },
    "ReceiptRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 15,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "receipt.disha8-2.thenitishkr.in"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "503",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2 Transaction Receipt: application release not available."
            }
          }
        ]
      }
    },
    "PublicApiRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 16,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "api.disha8-2.thenitishkr.in"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "503",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2 Public API: application release not available."
            }
          }
        ]
      }
    },
    "StatusRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 17,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "status.disha8-2.thenitishkr.in"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "503",
              "ContentType": "text/plain",
              "MessageBody": "DISHA 8.2 System Status: application release not available."
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "EdgeDns": {
      "Value": {
        "Fn::GetAtt": [
          "Edge",
          "DNSName"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-EdgeDns"
        }
      }
    },
    "EdgeArn": {
      "Value": {
        "Ref": "Edge"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-EdgeArn"
        }
      }
    },
    "EdgeSecurityGroupId": {
      "Value": {
        "Ref": "EdgeSecurityGroup"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-EdgeSecurityGroupId"
        }
      }
    },
    "CheckoutTargetArn": {
      "Value": {
        "Ref": "CheckoutTarget"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-CheckoutTargetArn"
        }
      }
    },
    "AgenticTargetArn": {
      "Value": {
        "Ref": "AgenticTarget"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-AgenticTargetArn"
        }
      }
    },
    "HttpsListenerArn": {
      "Value": {
        "Ref": "HttpsListener"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-HttpsListenerArn"
        }
      }
    }
  }
}
