{
  "id": "/checkout-share",
  "name": "PDEP Mobile Evidence Inbox",
  "short_name": "PDEP",
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/static/pdep-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-inbox",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "application/pdf",
            "text/plain"
          ]
        }
      ]
    }
  }
}